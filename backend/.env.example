# Copy to backend/.env and fill in. Never commit backend/.env.
ENVIRONMENT=development
LOG_LEVEL=INFO
BRAND_NAME=Agently

# Origins allowed to make state-changing requests (JSON list).
ALLOWED_ORIGINS=["http://localhost:3000"]
# Run uvicorn with --no-proxy-headers, or it overrides this setting.
# Proxies that append to X-Forwarded-For. The Next.js rewrite does not append: keep 0 locally.
# Production must set this explicitly, and only the proxies may reach the backend.
TRUSTED_PROXY_HOPS=0
# SESSION_COOKIE_SECURE defaults to true everywhere except ENVIRONMENT=development.
# SESSION_COOKIE_NAME=agently_session
# SESSION_TTL_DAYS=14
# Development only: lets docs/manual-checks/auth-browser-check.js be re-run (defaults: 5, 20).
SIGNUP_LIMIT_PER_IP=100
LOGIN_LIMIT_PER_IP=200

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver). Placeholder values only.
DATABASE_URL=postgresql+psycopg://agently:change-me@localhost:5432/agently
