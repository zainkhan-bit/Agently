# Copy to backend/.env and fill in. Never commit backend/.env.
ENVIRONMENT=development
LOG_LEVEL=INFO
BRAND_NAME=Agently

# Origins allowed to make state-changing requests (JSON list).
ALLOWED_ORIGINS=["http://localhost:3000"]
# Run uvicorn with --no-proxy-headers, or it overrides this setting.
# Proxies that append to X-Forwarded-For. The Next.js rewrite does not append: keep 0 locally.
# Production must set this explicitly, and only the proxies may reach the backend.
TRUSTED_PROXY_HOPS=0
# SESSION_COOKIE_SECURE defaults to true everywhere except ENVIRONMENT=development.
# SESSION_COOKIE_NAME=agently_session
# SESSION_TTL_DAYS=14
# Development only: lets docs/manual-checks/auth-browser-check.js be re-run (defaults: 5, 20).
SIGNUP_LIMIT_PER_IP=100
LOGIN_LIMIT_PER_IP=200

# AGENT_LIMIT_PER_WORKSPACE=50
# AGENT_WRITE_LIMIT=60
# AGENT_WRITE_WINDOW_MINUTES=10

# CONVERSATION_LIMIT_PER_AGENT=200   (per person)
# CONVERSATION_CREATE_LIMIT=30
# CONVERSATION_CREATE_WINDOW_MINUTES=60
# MESSAGE_LIMIT_PER_CONVERSATION=500
# USER_MESSAGE_MAX_CHARACTERS=8000
# ASSISTANT_MESSAGE_MAX_CHARACTERS=32000

# MESSAGE_SEND_LIMIT_PER_USER=60
# MESSAGE_SEND_LIMIT_PER_WORKSPACE=200
# MESSAGE_SEND_WINDOW_MINUTES=60
# RUNTIME_HISTORY_MESSAGES=20
# RUNTIME_INPUT_TOKEN_BUDGET=32000
# RUNTIME_MAX_OUTPUT_TOKENS=4000

# Agent and workspace writes: wait for each lock, and idleness while holding locks.
# WRITE_LOCK_TIMEOUT_SECONDS=5
# WRITE_IDLE_TIMEOUT_SECONDS=30

# Offers "Describe your agent". The mock makes sample drafts without AI; production refuses it.
MODEL_PROVIDER=mock
# MOCK_PROVIDER_SCENARIO=ok   (or timeout, rate_limited, unavailable, refused, malformed, slow, extra_field)
# MODEL_PROVIDER=gemini sends answers to Google and needs a key (aistudio.google.com).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (or gemini-3.8-flash)
# free: Google may use and review what people type, and production refuses it. Set paid only for
# a project with billing, after setting a monthly spend cap in AI Studio.
# GEMINI_TIER=free
# All real calls together, in US dollars: rolling 24 hours and 30 days. Warns in the log at 80%.
# PROVIDER_SPEND_LIMIT_DAILY=1
# PROVIDER_SPEND_LIMIT_MONTHLY=10
# PROVIDER_TIMEOUT_SECONDS=20
# GENERATION_LIMIT_PER_USER=10
# GENERATION_LIMIT_PER_WORKSPACE=30
# GENERATION_WINDOW_MINUTES=60

# Knowledge files. Empty = backend/var/knowledge (ignored by git). Never a folder that is served.
# KNOWLEDGE_STORAGE_DIR=
# KNOWLEDGE_MAX_FILE_BYTES=10000000
# KNOWLEDGE_STORAGE_LIMIT_PER_WORKSPACE_BYTES=200000000
# KNOWLEDGE_SOURCES_PER_AGENT=100
# KNOWLEDGE_UPLOAD_LIMIT_PER_USER=30
# KNOWLEDGE_UPLOAD_LIMIT_PER_WORKSPACE=100
# KNOWLEDGE_UPLOAD_WINDOW_MINUTES=60
# Searching an agent's knowledge (POST .../agents/{id}/knowledge/search). Questions are never logged.
# KNOWLEDGE_SEARCH_QUESTION_MAX_CHARS=500
# KNOWLEDGE_SEARCH_MAX_RESULTS=10
# KNOWLEDGE_SEARCH_DEFAULT_RESULTS=5
# KNOWLEDGE_SEARCH_EXCERPT_MAX_CHARS=1500
# KNOWLEDGE_SEARCH_LIMIT_PER_USER=60
# KNOWLEDGE_SEARCH_WINDOW_MINUTES=10

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver). Placeholder values only.
DATABASE_URL=postgresql+psycopg://agently:change-me@localhost:5432/agently
